{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "QADREN Cyber Control Surface",
  "status": "initial-implementation-baseline",
  "version": "2026-10-12",
  "brand": {
    "asset": "assets/qadren-logo.png",
    "widthPx": 192,
    "heightPx": 192,
    "keepOriginalColors": true,
    "wordmark": "QADREN"
  },
  "theme": {
    "default": "dark",
    "options": [
      "dark",
      "light",
      "system"
    ],
    "dark": {
      "canvas": "#06101B",
      "panel": "#0B1B2A",
      "raised": "#10273A",
      "overlay": "#152D41",
      "stroke": "#1B4058",
      "strokeHover": "#2B617B",
      "focus": "#19C5EF",
      "textPrimary": "#ECF7FF",
      "textSecondary": "#A9C2D2",
      "textDisabled": "#7B91A2"
    },
    "light": {
      "canvas": "#F1F7FA",
      "panel": "#FFFFFF",
      "raised": "#E9F2F7",
      "overlay": "#FFFFFF",
      "stroke": "#9DB9C9",
      "strokeHover": "#5688A4",
      "focus": "#006C98",
      "textPrimary": "#112C3C",
      "textSecondary": "#385869",
      "textDisabled": "#617D8B"
    }
  },
  "accent": {
    "brandCyan": "#0CB9F2",
    "brandBlue": "#2A80FF",
    "success": "#24CE86",
    "warning": "#FFB347",
    "danger": "#FF6376",
    "unknown": "#B4A1F5",
    "neutral": "#89A9BC"
  },
  "semantic": {
    "dark": {
      "active": "#0CB9F2",
      "ready": "#24CE86",
      "waiting": "#2A80FF",
      "needsAction": "#FFB347",
      "failed": "#FF6376",
      "unknown": "#B4A1F5",
      "neutral": "#A9C2D2"
    },
    "light": {
      "active": "#006C98",
      "ready": "#087443",
      "waiting": "#245E99",
      "needsAction": "#8A4B00",
      "failed": "#B3261E",
      "unknown": "#6550A5",
      "neutral": "#385869"
    }
  },
  "geometryPt": {
    "unit": 4,
    "canvasInset": 12,
    "widgetGap": 10,
    "widgetInset": 12,
    "widgetHeaderHeight": 32,
    "widgetRadius": 8,
    "controlRadius": 6,
    "stroke": 1,
    "menuIcon": 16,
    "widgetIcon": 14,
    "hitTargetMin": 24,
    "preferredHitTarget": 28
  },
  "typePt": {
    "body": 13,
    "secondary": 12,
    "caption": 11,
    "widgetTitle": 13,
    "inspectorTitle": 16,
    "metric": 20,
    "metricXL": 26,
    "technical": 12
  },
  "rowHeightPt": {
    "compact": 28,
    "regular": 34,
    "expanded": 42
  },
  "windowsPt": {
    "monitorDefault": {
      "width": 1180,
      "height": 760
    },
    "monitorMin": {
      "width": 900,
      "height": 620
    },
    "settingsDefault": {
      "width": 980,
      "height": 700
    },
    "settingsMin": {
      "width": 760,
      "height": 560
    }
  },
  "layout": {
    "columnsWide": 12,
    "columnsNarrow": 8,
    "narrowBreakpointPt": 1180,
    "minWidgetColumns": 2,
    "singleWidgetTypePerPanel": true
  },
  "motion": {
    "hoverMs": 120,
    "inspectMs": 180,
    "indefiniteDecorativeAnimations": false
  },
  "glow": {
    "idle": 0,
    "focusBlurPt": 3,
    "focusBorderPt": 1
  },
  "accessibility": {
    "textContrastMin": 4.5,
    "largeTextContrastMin": 3,
    "reduceMotion": true,
    "reduceTransparency": true,
    "voiceOver": false,
    "keyboardFocus": true
  }
}
